{
  "version": 1,
  "hooks": {
    "afterFileEdit": [
      {
        "matcher": "**/*",
        "command": "python3 scripts/secret_scan.py --hook"
      },
      {
        "matcher": "**/*",
        "command": "python3 scripts/ethics_check.py --hook"
      },
      {
        "matcher": "JOB_CARDS/**",
        "command": "python3 scripts/qa_check.py --hook"
      },
      {
        "matcher": "EXPERTS/**",
        "command": "python3 scripts/citation_check.py --hook"
      },
      {
        "matcher": "EXPERTS_TALENT/**",
        "command": "python3 scripts/citation_check.py --hook"
      },
      {
        "matcher": "RESEARCH/**",
        "command": "python3 scripts/citation_check.py --hook"
      },
      {
        "matcher": "FORECASTS/**",
        "command": "python3 scripts/citation_check.py --hook"
      },
      {
        "command": "python3 scripts/spec_validate.py"
      },
      {
        "command": "python3 scripts/secret_scan.py"
      },
      {
        "command": "python3 scripts/ethics_check.py"
      }
    ],
    "beforeShellExecution": [
      {
        "matcher": "rm -rf|curl.*\\|.*sh|wget.*\\|.*sh",
        "command": ".cursor/hooks/block-dangerous.sh",
        "failClosed": true,
        "timeout": 10
      }
    ],
    "beforeReadFile": [
      {
        "command": ".cursor/hooks/redact-secrets.sh"
      }
    ],
    "beforeShellExecution": [
      {
        "command": ".cursor/hooks/block-dangerous.sh",
        "failClosed": true
      }
    ],
    "beforeReadFile": [
      {
        "command": ".cursor/hooks/redact-secrets.sh"
      }
    ],
    "stop": [
      {
        "command": ".cursor/hooks/phase-audit.sh"
      },
      {
        "command": ".cursor/hooks/phase-audit-latos.sh"
      },
      {
        "command": "python3 scripts/phase_check.py"
      },
      {
        "command": ".cursor/hooks/phase-audit.sh"
      }
    ]
  }
}
