{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(python3 scripts/secret_scan.py *)",
      "Bash(python3 scripts/qa_check.py *)",
      "Bash(python3 scripts/citation_check.py *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(gh workflow run *)",
      "Bash(gh secret *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Bash(git push --force *)",
      "Bash(git push -f *)"
    ]
  }
}
